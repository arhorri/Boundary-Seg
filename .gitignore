# Raw input images — provisional sample set, not committed.
data/raw/

# Large intermediate/derived artefacts. Trailing-slash directory ignores
# prune traversal, which breaks later negations -- use `dir/*` instead so
# specific files inside can still be re-included.
data/interim/*
!data/interim/normalised/
data/interim/normalised/*
!data/interim/normalised/crop_log.csv
!data/interim/enhanced/
data/interim/enhanced/*
!data/interim/enhanced/enhance_log.csv
data/tiles/
**/tiles/
*.npy
*.npz
*.pt
*.pth

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/

# OS / editor
.DS_Store
